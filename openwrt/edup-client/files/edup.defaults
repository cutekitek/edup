#!/bin/sh
# Earlier versions kept the one tunnel server in the main section and routed
# to "proxy" or "bypass". Moves that server to a server section named vpn and
# names it, or "direct", wherever a route was chosen.

server="$(uci -q get edup.main.server)" || exit 0
migrated=
if [ -n "$server" ] && [ -z "$(uci -q show edup | grep '=server$')" ]; then
	uci set edup.vpn=server
	uci set edup.vpn.server="$server"
	uci set edup.vpn.user="$(uci -q get edup.main.user)"
	uci set edup.vpn.password="$(uci -q get edup.main.password)"
	migrated=1
fi
uci -q delete edup.main.server
uci -q delete edup.main.user
uci -q delete edup.main.password

# map <option>: proxy and all become vpn, bypass and off become direct.
# Without a migrated server, edup-client's configuration takes the first
# server for proxy and all.
map() {
	local value
	value="$(uci -q get "$1")" || return 0
	case "$value" in
	proxy|all) [ -n "$migrated" ] && uci set "$1=vpn" ;;
	bypass|off) uci set "$1=direct" ;;
	esac
}
map edup.main.default_route
map edup.main.lan_mode
[ "$(uci -q get edup.main.dns_proxy)" = 1 ] && [ -n "$migrated" ] && uci set edup.main.dns_proxy=vpn
i=0
while uci -q get "edup.@device[$i]" >/dev/null; do
	map "edup.@device[$i].mode"
	i=$((i + 1))
done
i=0
while uci -q get "edup.@rule[$i]" >/dev/null; do
	map "edup.@rule[$i].to"
	i=$((i + 1))
done
uci commit edup
exit 0
