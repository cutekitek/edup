#!/bin/sh /etc/rc.common
# edup tunnel client: /etc/config/edup -> /var/etc/edup/client.json.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/edup-client
CONFIG=/var/etc/edup/client.json
CORE=/var/etc/edup/core.json

generate() {
	ucode /usr/share/edup/genconfig.uc "$CONFIG" "$CORE"
}

start_service() {
	config_load edup
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	generate || return 1

	procd_open_instance main
	procd_set_param command "$PROG" --config "$CONFIG" run
	# The WAN may still be connecting at boot: retry until it is up.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Device modes apply without a restart: the client reloads its client table
# on SIGHUP. Anything else restarts it.
reload_service() {
	local old new
	old="$(cat "$CORE" 2>/dev/null)"
	config_load edup
	local enabled
	config_get_bool enabled main enabled 0
	if [ "$enabled" = 1 ] && [ -n "$old" ] && generate; then
		new="$(cat "$CORE")"
		if [ "$old" = "$new" ] && procd_running edup main; then
			procd_send_signal edup main HUP
			return 0
		fi
	fi
	stop
	start
}

# A cleanly stopped client restores dnsmasq itself; a crashed one leaves its
# forwarding behind, which would break DNS while the service stays stopped.
service_stopped() {
	local file removed=
	for file in /tmp/dnsmasq*.d/edup.conf; do
		[ -f "$file" ] && rm -f "$file" && removed=1
	done
	[ -n "$removed" ] && /etc/init.d/dnsmasq restart
	return 0
}

service_triggers() {
	procd_add_reload_trigger edup
	config_load edup
	local wan
	config_get wan main wan_interface wan
	# A new WAN address (e.g. a PPPoE reconnect) needs a new tunnel socket.
	[ -n "$wan" ] && procd_add_interface_trigger "interface.*.up" "$wan" /etc/init.d/edup restart
}
