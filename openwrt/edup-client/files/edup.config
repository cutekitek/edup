
config edup 'main'
	option enabled '0'
	# Tunnel server and credentials (edup-client credentials prints a pair).
	option server ''
	option user ''
	option password ''
	option tunnel_ip '10.66.0.1'
	option interface 'edup0'
	# Interface MTU minus 27 bytes (IPv4 tunnel): 1465 for PPPoE, 1473 for 1500.
	option mtu '1465'
	option keepalive '15'
	option xdp_mode 'auto'
	# Destinations no traffic rule matches: proxy (VPN) or bypass (direct).
	option default_route 'proxy'
	# Devices not listed below: rules, all or off.
	option lan_mode 'rules'
	option lan_network 'lan'
	# Restart when this interface comes up again, e.g. a PPPoE reconnect.
	option wan_interface 'wan'
	option dns_set_system '1'
	# Reach the DNS servers through the tunnel whatever the rules say.
	option dns_proxy '0'

# config device
#	option name 'Phone'
#	option ip '192.168.1.50'
#	# all: everything through the VPN, rules: traffic rules decide, off: no VPN
#	option mode 'all'

config rule
	option name 'Private networks'
	list ip '10.0.0.0/8'
	list ip '172.16.0.0/12'
	list ip '192.168.0.0/16'
	option to 'bypass'
