
config edup 'main'
	option enabled '0'
	option tunnel_ip '10.66.0.1'
	option interface 'edup0'
	# Interface MTU minus 27 bytes (IPv4 tunnel): 1465 for PPPoE, 1473 for 1500.
	option mtu '1465'
	option keepalive '15'
	option xdp_mode 'auto'
	# Destinations no traffic rule matches: a server's name or direct; the
	# first server when unset.
	# option default_route 'direct'
	# Devices not listed below: rules, direct or a server's name.
	option lan_mode 'rules'
	option lan_network 'lan'
	# Restart when this interface comes up again, e.g. a PPPoE reconnect.
	option wan_interface 'wan'
	option dns_set_system '1'
	# Reach the DNS servers through this server's tunnel whatever the rules
	# say; 0 lets the rules decide.
	option dns_proxy '0'

# Tunnel servers, named by their section (edup-client credentials prints a
# user and password). All servers use IPv4, or all IPv6.
# config server 'vpn'
#	option server '192.0.2.1:7777'
#	option user ''
#	option password ''

# config device
#	option name 'Phone'
#	option ip '192.168.1.50'
#	# rules: traffic rules decide, direct: no VPN, or a server's name
#	option mode 'vpn'

config rule
	option name 'Private networks'
	list ip '10.0.0.0/8'
	list ip '172.16.0.0/12'
	list ip '192.168.0.0/16'
	option to 'direct'
